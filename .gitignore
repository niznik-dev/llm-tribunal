__pycache__/
*.pyc
.idea/
.DS_Store
.venv/
.cache/

# SLURM job logs; logs/ itself stays in git because sbatch won't create it
logs/*
!logs/.gitkeep
*.out

# Local Claude Code state; only the shared instructions are committed
.claude/*
!.claude/CLAUDE.md

# Model weights: run.py points HF_HUB_CACHE here unless HF_HOME/HF_HUB_CACHE is already set
models/

# Run outputs stay local; commit a result on purpose with `git add -f`
results/**/*.csv
